{
  "name": "check",
  "description": "Code quality checker for bwflow. Runs checks and fixes issues automatically.",
  "prompt": "file://.kiro/agents/prompts/check.md",
  "tools": ["read", "write", "shell", "@git"],
  "allowedTools": ["read", "shell", "@git/git_status"],
  "hooks": {
    "agentSpawn": [
      {
        "command": "python3 .kiro/scripts/get_agent_context.py --agent check --update-phase"
      }
    ]
  },
  "model": "claude-sonnet-4-6"
}
