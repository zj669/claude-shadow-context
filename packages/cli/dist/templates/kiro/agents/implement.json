{
  "name": "implement",
  "description": "Code implementation expert for bwflow. Reads specs and requirements, implements features following guidelines.",
  "prompt": "file://.kiro/agents/prompts/implement.md",
  "tools": ["read", "write", "shell", "@git"],
  "allowedTools": ["read", "@git/git_status"],
  "hooks": {
    "agentSpawn": [
      {
        "command": "python3 .kiro/scripts/get_agent_context.py --agent implement --update-phase"
      }
    ]
  },
  "model": "claude-sonnet-4-6"
}
