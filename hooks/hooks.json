{
  "description": "claude-shadow-context hooks",
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/remind-load.mjs\" user-prompt",
            "timeout": 10,
            "statusMessage": "claude-shadow-context：提示优先通过蓝图探索上下文"
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/remind-load.mjs\" subagent-start",
            "timeout": 10,
            "statusMessage": "claude-shadow-context：为子 agent 注入蓝图优先上下文"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/session-align.mjs\"",
            "timeout": 30,
            "statusMessage": "claude-shadow-context：会话结束时异步检查蓝图对齐入口"
          }
        ]
      }
    ]
  }
}
